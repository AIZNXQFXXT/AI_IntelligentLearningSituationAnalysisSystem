<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.AiCallLogController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT">
        <Label text="AI调用日志" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <TextField fx:id="functionField" promptText="功能名称" prefWidth="150" styleClass="crud-search"/>
            <ComboBox fx:id="successFilter" prefWidth="100"/>
            <Button text="查询" styleClass="btn-primary" onAction="#handleSearch"/>
        </HBox>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colFunction" text="功能" prefWidth="120"/>
                <TableColumn fx:id="colModel" text="AI模型" prefWidth="120"/>
                <TableColumn fx:id="colCallerRole" text="调用角色" prefWidth="80"/>
                <TableColumn fx:id="colHttpStatus" text="HTTP" prefWidth="60"/>
                <TableColumn fx:id="colTokensIn" text="输入Token" prefWidth="90"/>
                <TableColumn fx:id="colTokensOut" text="输出Token" prefWidth="90"/>
                <TableColumn fx:id="colCost" text="费用" prefWidth="80"/>
                <TableColumn fx:id="colDuration" text="耗时(ms)" prefWidth="90"/>
                <TableColumn fx:id="colSuccess" text="状态" prefWidth="70"/>
                <TableColumn fx:id="colCreatedAt" text="时间" prefWidth="160"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
