<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.StudentDashboardController"
      spacing="20" prefWidth="900">

    <Label text="学生控制台" styleClass="page-title"/>

    <!-- Stat Cards -->
    <HBox spacing="20">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="最新平均分"/>
            <Label fx:id="valueAvgScore" styleClass="stat-card-value" text="--"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="预警数量"/>
            <Label fx:id="valueWarnings" styleClass="stat-card-value" text="--"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="欢迎"/>
            <Label fx:id="valueUsername" styleClass="stat-card-value" text="--"/>
        </VBox>
    </HBox>

    <!-- Recent Scores + Warnings -->
    <HBox spacing="20">
        <!-- Recent Scores -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="最近成绩" styleClass="section-title"/>
            <TableView fx:id="scoreTable" prefHeight="200">
                <columns>
                <TableColumn fx:id="colCourseId" text="课程ID" prefWidth="80"/>
                <TableColumn fx:id="colFinalScore" text="成绩" prefWidth="80"/>
                <TableColumn fx:id="colRankClass" text="班级排名" prefWidth="90"/>
                <TableColumn fx:id="colRankGrade" text="年级排名" prefWidth="90"/>
                </columns>
            </TableView>
            <Label fx:id="noScoreLabel" text="暂无成绩数据" visible="false"
                   styleClass="empty-state-label"/>
        </VBox>
        <!-- Recent Warnings -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="我的预警" styleClass="section-title"/>
            <TableView fx:id="warningTable" prefHeight="200">
                <columns>
                <TableColumn fx:id="colSemester" text="学期" prefWidth="100"/>
                <TableColumn fx:id="colRiskLevel" text="等级" prefWidth="80"/>
                <TableColumn fx:id="colRiskReason" text="原因" prefWidth="200"/>
                <TableColumn fx:id="colHandleStatus" text="状态" prefWidth="80"/>
                </columns>
            </TableView>
            <Label fx:id="noWarningLabel" text="暂无预警信息" visible="false"
                   styleClass="empty-state-label"/>
        </VBox>
    </HBox>

    <!-- Feature Navigation Cards -->
    <HBox spacing="20">
        <VBox styleClass="quick-action-card" HBox.hgrow="ALWAYS"
              onMouseClicked="#goToScores">
            <Label text="成绩查询" styleClass="quick-action-card-icon"/>
            <Label text="查看各科成绩和班级排名" styleClass="quick-action-card-sub"/>
        </VBox>
        <VBox styleClass="quick-action-card" HBox.hgrow="ALWAYS"
              onMouseClicked="#goToAnalysis">
            <Label text="成绩分析" styleClass="quick-action-card-icon"/>
            <Label text="查看成绩趋势和能力雷达图" styleClass="quick-action-card-sub"/>
        </VBox>
        <VBox styleClass="quick-action-card" HBox.hgrow="ALWAYS"
              onMouseClicked="#goToDiagnosis">
            <Label text="诊断报告" styleClass="quick-action-card-icon"/>
            <Label text="查看AI学情诊断分析" styleClass="quick-action-card-sub"/>
        </VBox>
    </HBox>
    <HBox spacing="20">
        <VBox styleClass="quick-action-card" HBox.hgrow="ALWAYS"
              onMouseClicked="#goToAdvice">
            <Label text="学习建议" styleClass="quick-action-card-icon"/>
            <Label text="查看个性化学习提升方案" styleClass="quick-action-card-sub"/>
        </VBox>
        <VBox styleClass="quick-action-card" HBox.hgrow="ALWAYS"
              onMouseClicked="#goToComment">
            <Label text="期末评语" styleClass="quick-action-card-icon"/>
            <Label text="查看教师评语" styleClass="quick-action-card-sub"/>
        </VBox>
        <VBox styleClass="quick-action-card" HBox.hgrow="ALWAYS"
              onMouseClicked="#goToRisk">
            <Label text="我的预警" styleClass="quick-action-card-icon"/>
            <Label text="查看学业预警信息" styleClass="quick-action-card-sub"/>
        </VBox>
    </HBox>
</VBox>
