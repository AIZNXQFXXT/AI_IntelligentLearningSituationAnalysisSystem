<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.SchoolStatsController"
      spacing="20" prefWidth="900" styleClass="crud-card">

    <Label text="全校学情" styleClass="crud-card-header"/>

    <VBox styleClass="crud-card-body" spacing="20">
        <HBox spacing="20">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="全校平均分"/>
                <Label fx:id="valueAvgScore" styleClass="stat-card-value" text="--"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="及格率"/>
                <Label fx:id="valuePassRate" styleClass="stat-card-value" text="--"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="不及格人数"/>
                <Label fx:id="valueFailCount" styleClass="stat-card-value" text="--"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="学生总数"/>
                <Label fx:id="valueTotalStudents" styleClass="stat-card-value" text="--"/>
            </VBox>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="班级:"/>
            <ComboBox fx:id="classFilter" prefWidth="200"/>
            <Label text="课程:"/>
            <ComboBox fx:id="courseFilter" prefWidth="200"/>
        </HBox>

        <BarChart fx:id="chart" prefHeight="400" animated="false">
            <CategoryAxis fx:id="xAxis" label="分数段" autoRanging="true"/>
            <NumberAxis fx:id="yAxis" label="人数" autoRanging="true"/>
        </BarChart>
    </VBox>
</VBox>
