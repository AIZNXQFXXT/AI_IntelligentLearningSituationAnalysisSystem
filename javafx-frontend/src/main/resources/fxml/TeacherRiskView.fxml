<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.TeacherRiskController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="风险预警"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label text="学期:"/>
        <ComboBox fx:id="semesterCombo" prefWidth="120"/>
        <Label text="等级:"/>
        <ComboBox fx:id="riskLevelCombo" prefWidth="100"/>
        <Label text="状态:"/>
        <ComboBox fx:id="statusCombo" prefWidth="100"/>
        <Button text="查询" onAction="#handleSearch" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="500">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colStudentId" text="学生ID" prefWidth="80"/>
                <TableColumn fx:id="colSemester" text="学期" prefWidth="100"/>
                <TableColumn fx:id="colRiskLevel" text="风险等级" prefWidth="100"/>
                <TableColumn fx:id="colReason" text="风险原因" prefWidth="250"/>
                <TableColumn fx:id="colStatus" text="处理状态" prefWidth="100"/>
                <TableColumn fx:id="colAction" text="操作" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
