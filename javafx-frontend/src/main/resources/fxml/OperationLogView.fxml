<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.OperationLogController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT">
        <Label text="操作日志" styleClass="crud-card-header-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <TextField fx:id="usernameField" promptText="用户名" prefWidth="120" styleClass="crud-search"/>
            <TextField fx:id="operationField" promptText="操作类型" prefWidth="120" styleClass="crud-search"/>
            <TextField fx:id="startDateField" promptText="开始 YYYY-MM-DD" prefWidth="140" styleClass="crud-search"/>
            <TextField fx:id="endDateField" promptText="结束 YYYY-MM-DD" prefWidth="140" styleClass="crud-search"/>
            <Button text="查询" styleClass="btn-primary" onAction="#handleSearch"/>
        </HBox>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colUsername" text="用户" prefWidth="100"/>
                <TableColumn fx:id="colOperation" text="操作" prefWidth="120"/>
                <TableColumn fx:id="colTargetType" text="目标类型" prefWidth="100"/>
                <TableColumn fx:id="colDetail" text="详情" prefWidth="200"/>
                <TableColumn fx:id="colIp" text="IP" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="状态" prefWidth="80"/>
                <TableColumn fx:id="colDuration" text="耗时(ms)" prefWidth="90"/>
                <TableColumn fx:id="colCreatedAt" text="时间" prefWidth="180"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
