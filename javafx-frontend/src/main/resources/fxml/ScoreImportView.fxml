<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.ScoreImportController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <Label text="批量导入成绩" styleClass="crud-card-header"/>

    <VBox styleClass="crud-card-body" spacing="15" padding="20">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="考试:"/>
            <ComboBox fx:id="examCombo" prefWidth="200"/>
            <Label text="班级:"/>
            <ComboBox fx:id="classCombo" prefWidth="200"/>
        </HBox>

        <HBox spacing="20" alignment="CENTER" VBox.vgrow="ALWAYS">
            <VBox spacing="10" alignment="CENTER" styleClass="import-step">
                <Label text="第1步" styleClass="step-title"/>
                <Label text="下载模板"/>
                <Button text="下载Excel模板" onAction="#handleDownloadTemplate" styleClass="btn-primary"/>
            </VBox>

            <Label text="→" style="-fx-font-size: 24;"/>

            <VBox spacing="10" alignment="CENTER" styleClass="import-step">
                <Label text="第2步" styleClass="step-title"/>
                <Label text="填写数据"/>
                <Label text="在模板中填写学生成绩"/>
            </VBox>

            <Label text="→" style="-fx-font-size: 24;"/>

            <VBox spacing="10" alignment="CENTER" styleClass="import-step">
                <Label text="第3步" styleClass="step-title"/>
                <Label text="上传文件"/>
                <Button text="选择并上传文件" onAction="#handleUpload" styleClass="btn-primary"/>
            </VBox>
        </HBox>

        <Label fx:id="resultLabel" text="" style="-fx-text-fill: #67C23A;" visible="false"/>
    </VBox>
</VBox>
