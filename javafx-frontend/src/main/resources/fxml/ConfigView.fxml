<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.ConfigController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <Label text="系统配置" styleClass="crud-card-header"/>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colKey" text="配置键" prefWidth="200"/>
                <TableColumn fx:id="colValue" text="配置值" prefWidth="300"/>
                <TableColumn fx:id="colDesc" text="描述" prefWidth="200"/>
                <TableColumn fx:id="colAction" text="操作" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
