<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.StudentAdviceController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <Label text="AI学习建议" styleClass="crud-card-header"/>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS" spacing="15" padding="20">
        <Label fx:id="emptyLabel" text="暂无学习建议，请等待教师生成AI诊断"
               style="-fx-text-fill: #999; -fx-font-size: 14;" visible="false"/>

        <VBox fx:id="contentBox" spacing="10" visible="false">
            <Label styleClass="section-title" text="诊断文本"/>
            <TextArea fx:id="diagnosisText" editable="false" prefHeight="120"
                      styleClass="readonly-textarea"/>

            <Label styleClass="section-title" text="优势"/>
            <TextArea fx:id="strengths" editable="false" prefHeight="80"
                      styleClass="readonly-textarea"/>

            <Label styleClass="section-title" text="劣势"/>
            <TextArea fx:id="weaknesses" editable="false" prefHeight="80"
                      styleClass="readonly-textarea"/>

            <Label styleClass="section-title" text="趋势分析"/>
            <TextArea fx:id="trendAnalysis" editable="false" prefHeight="80"
                      styleClass="readonly-textarea"/>
        </VBox>
    </VBox>
</VBox>
