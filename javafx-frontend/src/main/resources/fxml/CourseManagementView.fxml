<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.CourseManagementController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT">
        <Label text="课程管理" styleClass="crud-card-header-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <ComboBox fx:id="typeFilter" promptText="课程类型" prefWidth="120"/>
            <TextField fx:id="keywordField" promptText="搜索课程名称"
                       prefWidth="200" onKeyPressed="#onSearchKeyPressed" styleClass="crud-search"/>
            <Button text="新增课程" styleClass="btn-primary" onAction="#handleCreate"/>
            <Button text="批量导入" styleClass="btn-warning" onAction="#handleBatchImport"/>
        </HBox>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="400">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colName" text="课程名称" prefWidth="150"/>
                <TableColumn fx:id="colType" text="类型" prefWidth="100"/>
                <TableColumn fx:id="colCredit" text="学分" prefWidth="80"/>
                <TableColumn fx:id="colDescription" text="描述" prefWidth="200"/>
                <TableColumn fx:id="colStatus" text="状态" prefWidth="80"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="180"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
