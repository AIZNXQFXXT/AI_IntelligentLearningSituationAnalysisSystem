<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.WebViewContainerController"
      prefWidth="900">

    <!-- Navigation toolbar -->
    <HBox styleClass="web-view-toolbar" spacing="8" alignment="CENTER_LEFT" prefHeight="40">
        <padding><Insets left="12" right="12" top="6" bottom="6"/></padding>
        <Button fx:id="btnBack" text="←" onAction="#goBack"
                style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 2 8;"
                disable="true"/>
        <Button fx:id="btnForward" text="→" onAction="#goForward"
                style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 2 8;"
                disable="true"/>
        <Button fx:id="btnRefresh" text="⟳" onAction="#refresh"
                style="-fx-background-color: transparent; -fx-font-size: 16px; -fx-cursor: hand; -fx-padding: 2 8;"/>
        <Separator orientation="VERTICAL" prefHeight="20"/>
        <Label fx:id="loadingLabel" text="加载中..." style="-fx-text-fill: #909399; -fx-font-size: 12px;" visible="false"/>
    </HBox>

    <!-- WebView fills remaining space -->
    <BorderPane fx:id="webContainer" VBox.vgrow="ALWAYS" styleClass="web-view-container"/>
</VBox>
