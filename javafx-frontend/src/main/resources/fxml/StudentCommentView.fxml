<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.aicampus.controller.StudentCommentController"
      spacing="0" prefWidth="900" styleClass="crud-card">

    <Label text="期末评语" styleClass="crud-card-header"/>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <Label fx:id="emptyLabel" text="暂无评语" visible="false" managed="false"
               styleClass="empty-state-label" VBox.vgrow="ALWAYS"
               alignment="CENTER"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="500">
            <columns>
                <TableColumn fx:id="colSemester" text="学期" prefWidth="120"/>
                <TableColumn fx:id="colContent" text="评语内容" prefWidth="400"/>
                <TableColumn fx:id="colEdited" text="教师已编辑" prefWidth="100"/>
                <TableColumn fx:id="colCreatedAt" text="创建时间" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
