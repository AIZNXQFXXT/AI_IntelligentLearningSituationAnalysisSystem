<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.MainLayoutController"
      prefWidth="1200" prefHeight="800">

    <!-- Top Bar — full width -->
    <HBox styleClass="top-bar" prefHeight="60" minHeight="60" maxHeight="60" alignment="CENTER_LEFT">
        <padding><Insets left="20" right="20"/></padding>
        <Label text="AI学情分析" styleClass="top-bar-logo"/>
        <Label fx:id="pageTitle" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
        <Label fx:id="usernameLabel" styleClass="top-bar-username"/>
        <Button fx:id="logoutBtn" text="退出" onAction="#handleLogout"
                styleClass="button-danger"/>
    </HBox>

    <!-- Content: Sidebar + Main Area -->
    <BorderPane VBox.vgrow="ALWAYS">
        <left>
            <VBox styleClass="sidebar" prefWidth="220">
                <VBox fx:id="menuContainer" VBox.vgrow="ALWAYS" styleClass="sidebar-menu-container"/>
            </VBox>
        </left>
        <center>
            <BorderPane fx:id="contentArea" styleClass="content-area"/>
        </center>
    </BorderPane>
</VBox>
