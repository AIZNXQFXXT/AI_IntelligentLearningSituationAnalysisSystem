<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.GradeAnalyticsController"
      spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <Label text="年级学情分析" styleClass="crud-card-header"/>

    <VBox styleClass="crud-card-body" spacing="20">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="年级:"/>
            <ComboBox fx:id="gradeFilter" prefWidth="200" promptText="选择年级"/>
            <Label text="课程:"/>
            <ComboBox fx:id="courseFilter" prefWidth="200" promptText="选择课程"/>
            <Button text="查询" styleClass="btn-primary btn-sm" onAction="#handleQuery"/>
        </HBox>

        <!-- Stats Cards -->
        <HBox spacing="20">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="平均分"/>
                <Label fx:id="valueAvgScore" styleClass="stat-card-value" text="--"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="及格率"/>
                <Label fx:id="valuePassRate" styleClass="stat-card-value" text="--"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="挂科人数"/>
                <Label fx:id="valueFailCount" styleClass="stat-card-value" text="--"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label styleClass="stat-card-title" text="学生总数"/>
                <Label fx:id="valueTotalStudents" styleClass="stat-card-value" text="--"/>
            </VBox>
        </HBox>

        <!-- Data Table -->
        <VBox spacing="8">
            <Label text="各班级成绩概览" styleClass="section-title"/>
            <TableView fx:id="dataTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colClassName" text="班级" prefWidth="120"/>
                    <TableColumn fx:id="colStudentCount" text="学生数" prefWidth="80"/>
                    <TableColumn fx:id="colAvgScore" text="平均分" prefWidth="80"/>
                    <TableColumn fx:id="colPassRate" text="及格率" prefWidth="80"/>
                    <TableColumn fx:id="colMaxScore" text="最高分" prefWidth="80"/>
                    <TableColumn fx:id="colMinScore" text="最低分" prefWidth="80"/>
                </columns>
            </TableView>
            <Label fx:id="noDataLabel" text="暂无数据" visible="false" styleClass="empty-state-label"/>
        </VBox>

        <!-- GPA Ranking Table -->
        <VBox spacing="8">
            <Label text="年级 GPA 排名" styleClass="section-title"/>
            <TableView fx:id="gpaRankTable" VBox.vgrow="ALWAYS" prefHeight="300">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colGpaRank" text="排名" prefWidth="60"/>
                    <TableColumn fx:id="colGpaStudentNo" text="学号" prefWidth="120"/>
                    <TableColumn fx:id="colGpaStudentName" text="姓名" prefWidth="100"/>
                    <TableColumn fx:id="colGpaClassName" text="班级" prefWidth="120"/>
                    <TableColumn fx:id="colGpaScore" text="GPA" prefWidth="80"/>
                    <TableColumn fx:id="colGpaCourseCount" text="课程数" prefWidth="80"/>
                </columns>
            </TableView>
            <Label fx:id="noGpaDataLabel" text="暂无数据" visible="false" styleClass="empty-state-label"/>
        </VBox>
    </VBox>
</VBox>
