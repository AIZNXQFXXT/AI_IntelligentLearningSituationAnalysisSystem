<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.client.controller.TeacherScoreController"
            stylesheets="/css/main.css"
            styleClass="content-area">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="成绩管理" styleClass="page-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="examFilter" promptText="选择考试" prefWidth="160"/>
            <ComboBox fx:id="courseFilter" promptText="选择课程" prefWidth="160"/>
            <Button text="查询" onAction="#handleSearch" styleClass="button"/>
            <Button text="录入成绩" onAction="#handleAdd" styleClass="button-success"/>
            <Button text="批量录入" onAction="#handleBatchAdd" styleClass="button-outline"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" text="" styleClass="text-muted"/>
        </HBox>

        <TableView fx:id="scoreTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colStudentNo" text="学号" prefWidth="100"/>
                <TableColumn fx:id="colStudentName" text="姓名" prefWidth="100"/>
                <TableColumn fx:id="colCourseName" text="课程" prefWidth="120"/>
                <TableColumn fx:id="colExamName" text="考试" prefWidth="140"/>
                <TableColumn fx:id="colScore" text="成绩" prefWidth="80"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="120"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="prevBtn" text="上一页" onAction="#handlePrevPage" styleClass="button-outline"/>
            <Label fx:id="pageInfo" text="第 1 页"/>
            <Button fx:id="nextBtn" text="下一页" onAction="#handleNextPage" styleClass="button-outline"/>
        </HBox>
    </VBox>
</AnchorPane>
