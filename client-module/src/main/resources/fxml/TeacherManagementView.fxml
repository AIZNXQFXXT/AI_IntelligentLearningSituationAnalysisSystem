<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.TeacherManagementController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT">
        <Label text="教师管理" styleClass="crud-card-header-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <TextField fx:id="keywordField" promptText="搜索教师姓名/工号"
                       prefWidth="200" onKeyPressed="#onSearchKeyPressed" styleClass="crud-search"/>
            <Button text="批量导入" styleClass="btn-warning" onAction="#handleBatchImport"/>
            <Button text="新增教师" styleClass="btn-primary" onAction="#handleCreate"/>
        </HBox>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colTeacherNo" text="工号" prefWidth="100"/>
                <TableColumn fx:id="colName" text="姓名" prefWidth="100"/>
                <TableColumn fx:id="colTitle" text="职称" prefWidth="100"/>
                <TableColumn fx:id="colSubject" text="学科" prefWidth="100"/>
                <TableColumn fx:id="colDepartment" text="部门" prefWidth="120"/>
                <TableColumn fx:id="colEducation" text="学历" prefWidth="80"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="180" minWidth="130"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
