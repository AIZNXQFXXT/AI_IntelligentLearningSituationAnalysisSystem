<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.ExamManagementController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT">
        <Label text="考试批次" styleClass="crud-card-header-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <TextField fx:id="semesterField" promptText="搜索学期"
                       prefWidth="150" onKeyPressed="#onSearchKeyPressed" styleClass="crud-search"/>
            <Button text="新增考试" styleClass="btn-primary" onAction="#handleCreate"/>
        </HBox>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colName" text="考试名称" prefWidth="150"/>
                <TableColumn fx:id="colType" text="类型" prefWidth="80"/>
                <TableColumn fx:id="colSemester" text="学期" prefWidth="100"/>
                <TableColumn fx:id="colClassId" text="班级" prefWidth="150"/>
                <TableColumn fx:id="colExamDate" text="考试日期" prefWidth="120"/>
                <TableColumn fx:id="colArchived" text="归档状态" prefWidth="100"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="220" minWidth="200"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
