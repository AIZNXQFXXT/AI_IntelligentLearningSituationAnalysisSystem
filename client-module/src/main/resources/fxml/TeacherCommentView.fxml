<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.TeacherCommentController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="评语管理"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label text="班级:"/>
        <ComboBox fx:id="classCombo" prefWidth="150"/>
        <Label text="学期:"/>
        <ComboBox fx:id="semesterCombo" prefWidth="120"/>
        <TextField fx:id="searchField" promptText="学号 / 姓名" prefWidth="160" styleClass="crud-search"/>
        <Button text="查询" onAction="#handleSearch" styleClass="btn-primary"/>
        <Button text="AI批量生成" onAction="#handleBatchGenerate" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colStudentName" text="学生" prefWidth="100"/>
                <TableColumn fx:id="colClassName" text="班级" prefWidth="100"/>
                <TableColumn fx:id="colSemester" text="学期" prefWidth="100"/>
                <TableColumn fx:id="colContent" text="评语内容" prefWidth="350"/>
                <TableColumn fx:id="colEdited" text="教师已编辑" prefWidth="100"/>
                <TableColumn fx:id="colCreatedAt" text="创建时间" prefWidth="160"/>
                <TableColumn fx:id="colAction" text="操作" prefWidth="150" minWidth="120"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
