<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.StudentProfileController"
      spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

    <Label text="个人主页" styleClass="page-title"/>

    <HBox spacing="20">
        <!-- Left: Profile Card -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16">
            <Label text="基本信息" styleClass="section-title"/>
            <GridPane hgap="16" vgap="12">
                <Label text="学号:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card-title"/>
                <Label fx:id="valueStudentNo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="姓名:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="stat-card-title"/>
                <Label fx:id="valueName" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="性别:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="stat-card-title"/>
                <Label fx:id="valueGender" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="班级:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="stat-card-title"/>
                <Label fx:id="valueClassName" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="入学年份:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="stat-card-title"/>
                <Label fx:id="valueEnrollYear" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="状态:" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="stat-card-title"/>
                <Label fx:id="valueStatus" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>
        </VBox>

        <!-- Right: Edit Profile -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16">
            <Label text="修改个人信息" styleClass="section-title"/>
            <VBox spacing="10">
                <Label text="手机号:" styleClass="stat-card-title"/>
                <TextField fx:id="phoneField" promptText="请输入手机号" prefHeight="36"/>
                <Label text="监护人电话:" styleClass="stat-card-title"/>
                <TextField fx:id="guardianPhoneField" promptText="请输入监护人电话" prefHeight="36"/>
                <Label fx:id="editResultLabel" visible="false" managed="false"/>
                <Button text="保存修改" styleClass="btn-primary" onAction="#handleSave" prefHeight="36"/>
            </VBox>
        </VBox>
    </HBox>

    <!-- Password Change -->
    <VBox styleClass="stat-card" spacing="16">
        <Label text="修改密码" styleClass="section-title"/>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="旧密码:" styleClass="stat-card-title"/>
                <PasswordField fx:id="oldPassword" promptText="请输入旧密码" prefHeight="36"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="新密码:" styleClass="stat-card-title"/>
                <PasswordField fx:id="newPassword" promptText="请输入新密码" prefHeight="36"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="确认密码:" styleClass="stat-card-title"/>
                <PasswordField fx:id="confirmPassword" promptText="请再次输入新密码" prefHeight="36"/>
            </VBox>
            <VBox spacing="8">
                <Label text=" "/>
                <Button text="修改密码" styleClass="btn-warning" onAction="#handleChangePassword" prefHeight="36"/>
            </VBox>
        </HBox>
        <Label fx:id="passwordResultLabel" visible="false" managed="false"/>
    </VBox>
</VBox>
