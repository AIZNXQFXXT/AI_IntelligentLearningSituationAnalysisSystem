<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.client.controller.CourseController"
            stylesheets="/css/main.css"
            styleClass="content-area">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="课程管理" styleClass="page-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="新增课程" onAction="#handleAdd" styleClass="button-success"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" text="" styleClass="text-muted"/>
        </HBox>

        <TableView fx:id="courseTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colCourseName" text="课程名称" prefWidth="150"/>
                <TableColumn fx:id="colCourseCode" text="课程代码" prefWidth="100"/>
                <TableColumn fx:id="colCredit" text="学分" prefWidth="60"/>
                <TableColumn fx:id="colTeacherName" text="授课教师" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="状态" prefWidth="80"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="180"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="prevBtn" text="上一页" onAction="#handlePrevPage" styleClass="button-outline"/>
            <Label fx:id="pageInfo" text="第 1 页"/>
            <Button fx:id="nextBtn" text="下一页" onAction="#handleNextPage" styleClass="button-outline"/>
        </HBox>
    </VBox>
</AnchorPane>
