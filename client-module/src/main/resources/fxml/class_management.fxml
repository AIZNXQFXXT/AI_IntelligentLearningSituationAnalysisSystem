<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.client.controller.ClassController"
            stylesheets="/css/main.css"
            styleClass="content-area">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="班级管理" styleClass="page-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="新增班级" onAction="#handleAdd" styleClass="button-success"/>
            <Button text="导出Excel" onAction="#handleExport" styleClass="button-outline"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" text="" styleClass="text-muted"/>
        </HBox>

        <TableView fx:id="classTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colClassName" text="班级名称" prefWidth="150"/>
                <TableColumn fx:id="colGrade" text="年级" prefWidth="100"/>
                <TableColumn fx:id="colTeacherName" text="班主任" prefWidth="100"/>
                <TableColumn fx:id="colStudentCount" text="学生人数" prefWidth="80"/>
                <TableColumn fx:id="colCreateTime" text="创建时间" prefWidth="150"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="180"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="prevBtn" text="上一页" onAction="#handlePrevPage" styleClass="button-outline"/>
            <Label fx:id="pageInfo" text="第 1 页"/>
            <Button fx:id="nextBtn" text="下一页" onAction="#handleNextPage" styleClass="button-outline"/>
        </HBox>
    </VBox>
</AnchorPane>
