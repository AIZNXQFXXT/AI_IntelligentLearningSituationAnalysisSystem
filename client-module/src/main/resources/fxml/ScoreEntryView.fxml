<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.ScoreEntryController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <Label text="成绩录入" styleClass="crud-card-header"/>

    <HBox styleClass="crud-card-body" spacing="10" alignment="CENTER_LEFT">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <Label text="考试:"/>
        <ComboBox fx:id="examCombo" prefWidth="150"/>
        <Label text="课程:"/>
        <ComboBox fx:id="courseCombo" prefWidth="150"/>
        <Label text="班级:"/>
        <ComboBox fx:id="classCombo" prefWidth="150"/>
        <Button fx:id="loadBtn" text="加载学生" onAction="#handleLoadStudents" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colStudentNo" text="学号" prefWidth="120"/>
                <TableColumn fx:id="colName" text="姓名" prefWidth="100"/>
                <TableColumn fx:id="colRegular" text="平时分" prefWidth="120"/>
                <TableColumn fx:id="colExam" text="卷面分" prefWidth="120"/>
                <TableColumn fx:id="colFinal" text="总评成绩" prefWidth="120"/>
                <TableColumn fx:id="colStatus" text="状态" prefWidth="100"/>
                <TableColumn fx:id="colAction" text="操作" prefWidth="180" minWidth="180"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
