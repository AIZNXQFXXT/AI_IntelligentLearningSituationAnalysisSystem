<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.TeacherDiagnosisController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="AI诊断"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label text="学期:"/>
        <ComboBox fx:id="semesterCombo" prefWidth="120"/>
        <Label text="学生:"/>
        <ComboBox fx:id="studentCombo" prefWidth="150"/>
        <TextField fx:id="searchField" promptText="学号 / 姓名" prefWidth="160" styleClass="crud-search"/>
        <Button text="查询" onAction="#handleSearch" styleClass="btn-primary"/>
        <Button text="生成诊断" onAction="#handleGenerate" styleClass="btn-success"/>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colStudent" text="学生" prefWidth="150"/>
                <TableColumn fx:id="colSemester" text="学期" prefWidth="100"/>
                <TableColumn fx:id="colRiskLevel" text="风险等级" prefWidth="100"/>
                <TableColumn fx:id="colDiagnosis" text="诊断摘要" prefWidth="250"/>
                <TableColumn fx:id="colCreatedAt" text="创建时间" prefWidth="160"/>
                <TableColumn fx:id="colAction" text="操作" prefWidth="100" minWidth="100"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
