<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.ClassStatsController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT" spacing="10">
        <Label text="班级统计"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <Label text="班级:"/>
        <ComboBox fx:id="classCombo" prefWidth="150"/>
        <Label text="课程:"/>
        <ComboBox fx:id="courseCombo" prefWidth="150"/>
        <Button text="查看统计" onAction="#handleLoadStats" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="crud-card-body" spacing="15" VBox.vgrow="ALWAYS">
        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
        <HBox spacing="15">
            <VBox styleClass="stat-card" prefWidth="140" alignment="CENTER">
                <Label text="平均分" styleClass="stat-label"/>
                <Label fx:id="avgScore" text="--" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="140" alignment="CENTER">
                <Label text="最高分" styleClass="stat-label"/>
                <Label fx:id="maxScore" text="--" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="140" alignment="CENTER">
                <Label text="最低分" styleClass="stat-label"/>
                <Label fx:id="minScore" text="--" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="140" alignment="CENTER">
                <Label text="及格率" styleClass="stat-label"/>
                <Label fx:id="passRate" text="--" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="140" alignment="CENTER">
                <Label text="优秀率" styleClass="stat-label"/>
                <Label fx:id="excellentRate" text="--" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" prefWidth="140" alignment="CENTER">
                <Label text="学生人数" styleClass="stat-label"/>
                <Label fx:id="studentCount" text="--" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <HBox spacing="15" VBox.vgrow="ALWAYS">
            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="5">
                <Label text="成绩分布" styleClass="section-title"/>
                <BarChart fx:id="distributionChart" prefHeight="300" animated="false">
                    <xAxis>
                        <CategoryAxis fx:id="distXAxis" label="分数段"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="distYAxis" label="人数"/>
                    </yAxis>
                </BarChart>
            </VBox>
            <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="5">
                <Label text="学期趋势" styleClass="section-title"/>
                <LineChart fx:id="trendChart" prefHeight="300" animated="false">
                    <xAxis>
                        <CategoryAxis fx:id="trendXAxis" label="学期"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="trendYAxis" label="平均分"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </HBox>
    </VBox>
</VBox>
