<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.client.controller.StudentDashboardController"
            stylesheets="/css/main.css"
            styleClass="content-area">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="我的学业概览" styleClass="page-title"/>

        <HBox spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="已修课程" styleClass="stat-label"/>
                <Label fx:id="courseCount" text="0" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="平均分" styleClass="stat-label"/>
                <Label fx:id="avgScore" text="0" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="学业预警" styleClass="stat-label"/>
                <Label fx:id="warningCount" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <!-- Recent Scores -->
        <VBox styleClass="card" spacing="12">
            <Label text="最近成绩" styleClass="card-title"/>
            <TableView fx:id="recentScoreTable" prefHeight="200">
                <columns>
                    <TableColumn fx:id="colCourseName" text="课程" prefWidth="140"/>
                    <TableColumn fx:id="colExamName" text="考试" prefWidth="140"/>
                    <TableColumn fx:id="colScore" text="成绩" prefWidth="100"/>
                    <TableColumn fx:id="colRank" text="排名" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Suggestions -->
        <VBox styleClass="card" spacing="12">
            <Label text="学习建议" styleClass="card-title"/>
            <VBox fx:id="suggestionList" spacing="8"/>
        </VBox>

        <!-- Warnings -->
        <VBox styleClass="card" spacing="12">
            <Label text="学业预警" styleClass="card-title"/>
            <VBox fx:id="warningList" spacing="8"/>
        </VBox>
    </VBox>
</AnchorPane>
