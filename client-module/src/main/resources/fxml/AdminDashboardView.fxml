<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.AdminDashboardController"
      spacing="20" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">

    <Label text="管理员控制台" styleClass="page-title"/>

    <!-- Stat Cards Row -->
    <HBox spacing="20">
        <VBox fx:id="cardClasses" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="班级总数"/>
            <Label fx:id="valueClasses" styleClass="stat-card-value" text="--"/>
        </VBox>
        <VBox fx:id="cardTeachers" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="教师总数"/>
            <Label fx:id="valueTeachers" styleClass="stat-card-value" text="--"/>
        </VBox>
        <VBox fx:id="cardStudents" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="学生总数"/>
            <Label fx:id="valueStudents" styleClass="stat-card-value" text="--"/>
        </VBox>
        <VBox fx:id="cardCourses" styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label styleClass="stat-card-title" text="课程总数"/>
            <Label fx:id="valueCourses" styleClass="stat-card-value" text="--"/>
        </VBox>
    </HBox>

    <!-- Quick Actions + System Overview -->
    <HBox spacing="20">
        <!-- Quick Actions -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="12">
            <Label text="快捷操作" styleClass="section-title"/>
            <VBox spacing="12">
                <Button text="班级管理" styleClass="quick-action-btn"
                        onAction="#goToClasses"/>
                <Button text="教师管理" styleClass="quick-action-btn"
                        onAction="#goToTeachers"/>
                <Button text="学生管理" styleClass="quick-action-btn"
                        onAction="#goToStudents"/>
                <Button text="教学任务" styleClass="quick-action-btn"
                        onAction="#goToTeachingTasks"/>
            </VBox>
        </VBox>
        <!-- System Overview -->
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="8">
            <Label text="系统概览" styleClass="section-title"/>
            <GridPane hgap="16" vgap="8">
                <Label text="系统状态" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="正常运行" styleClass="status-success" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="AI服务" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="DeepSeek / GLM" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="版本" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="v1.0.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>
    </HBox>
</VBox>
