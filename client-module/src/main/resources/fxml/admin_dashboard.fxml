<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.client.controller.AdminDashboardController"
            stylesheets="/css/main.css"
            styleClass="content-area">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="管理员仪表盘" styleClass="page-title"/>

        <!-- Stat Cards Row -->
        <HBox spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="总学生数" styleClass="stat-label"/>
                <Label fx:id="totalStudents" text="0" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="总教师数" styleClass="stat-label"/>
                <Label fx:id="totalTeachers" text="0" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="总班级数" styleClass="stat-label"/>
                <Label fx:id="totalClasses" text="0" styleClass="stat-value"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="4">
                <Label text="总课程数" styleClass="stat-label"/>
                <Label fx:id="totalCourses" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <!-- Risk Summary -->
        <VBox styleClass="card" spacing="12">
            <Label text="学业风险概览" styleClass="card-title"/>
            <HBox spacing="16">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="高风险学生" styleClass="text-danger text-bold"/>
                    <Label fx:id="highRiskCount" text="0" styleClass="text-danger" style="-fx-font-size:20px;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="中风险学生" styleClass="text-warning text-bold"/>
                    <Label fx:id="midRiskCount" text="0" styleClass="text-warning" style="-fx-font-size:20px;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="待处理预警" styleClass="text-bold"/>
                    <Label fx:id="pendingWarnings" text="0" styleClass="text-info" style="-fx-font-size:20px;"/>
                </VBox>
            </HBox>
        </VBox>

        <Button fx:id="refreshButton" text="刷新数据" onAction="#handleRefresh" styleClass="button"/>
    </VBox>
</AnchorPane>
