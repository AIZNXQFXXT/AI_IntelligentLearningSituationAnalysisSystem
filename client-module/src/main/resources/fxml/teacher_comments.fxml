<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.client.controller.TeacherCommentController"
            stylesheets="/css/main.css"
            styleClass="content-area">

    <VBox spacing="16" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="评语管理" styleClass="page-title"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="新增评语" onAction="#handleAdd" styleClass="button-success"/>
            <HBox HBox.hgrow="ALWAYS"/>
        </HBox>

        <TableView fx:id="commentTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colStudentName" text="学生" prefWidth="100"/>
                <TableColumn fx:id="colCourseName" text="课程" prefWidth="120"/>
                <TableColumn fx:id="colContent" text="评语内容" prefWidth="300"/>
                <TableColumn fx:id="colType" text="类型" prefWidth="80"/>
                <TableColumn fx:id="colCreateTime" text="创建时间" prefWidth="150"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="100"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="prevBtn" text="上一页" onAction="#handlePrevPage" styleClass="button-outline"/>
            <Label fx:id="pageInfo" text="第 1 页"/>
            <Button fx:id="nextBtn" text="下一页" onAction="#handleNextPage" styleClass="button-outline"/>
        </HBox>
    </VBox>
</AnchorPane>
