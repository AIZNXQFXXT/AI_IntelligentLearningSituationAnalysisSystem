<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.campus.client.controller.StudentManagementController"
      spacing="0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="crud-card">

    <HBox styleClass="crud-card-header" alignment="CENTER_LEFT">
        <Label text="学生管理" styleClass="crud-card-header-title"/>
        <HBox HBox.hgrow="ALWAYS"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <ComboBox fx:id="classFilter" promptText="选择班级" prefWidth="150"/>
            <TextField fx:id="keywordField" promptText="搜索学生姓名/学号"
                       prefWidth="200" onKeyPressed="#onSearchKeyPressed" styleClass="crud-search"/>
            <Button text="批量导入" styleClass="btn-warning" onAction="#handleBatchImport"/>
            <Button text="新增学生" styleClass="btn-primary" onAction="#handleCreate"/>
        </HBox>
    </HBox>

    <VBox styleClass="crud-card-body" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colStudentNo" text="学号" prefWidth="130"/>
                <TableColumn fx:id="colName" text="姓名" prefWidth="100"/>
                <TableColumn fx:id="colGender" text="性别" prefWidth="60"/>
                <TableColumn fx:id="colClassName" text="班级" prefWidth="120"/>
                <TableColumn fx:id="colEnrollYear" text="入学年份" prefWidth="80"/>
                <TableColumn fx:id="colPhone" text="电话" prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="状态" prefWidth="70"/>
                <TableColumn fx:id="colActions" text="操作" prefWidth="180" minWidth="180"/>
            </columns>
        </TableView>
        <Pagination fx:id="pagination" styleClass="crud-pagination"/>
    </VBox>
</VBox>
